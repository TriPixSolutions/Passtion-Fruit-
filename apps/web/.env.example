PF_ENV=development
PF_APP_URL=http://localhost:3000
PF_SITE_URL=http://localhost:3000
PF_DEPLOYMENT_PROFILE=hostinger-pilot
PF_LOG_LEVEL=info

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
PF_SUPABASE_URL=https://PROJECT.supabase.co
PF_SUPABASE_SERVER_KEY=replace-with-server-secret-key

PF_META_APP_ID=replace-with-meta-app-id
PF_META_APP_SECRET=replace-with-meta-app-secret
PF_META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
PF_META_GRAPH_VERSION=replace-with-current-supported-version
PF_META_SIGNUP_CONFIG_ID=replace-after-embedded-signup-configuration
# Optional pilot asset references used during setup and operations.
PF_META_TEST_PHONE_NUMBER_ID=replace-with-meta-test-phone-number-id
PF_META_TEST_WABA_ID=replace-with-meta-test-waba-id
# Local pilot testing only. Temporary tokens expire; never expose this value to the browser.
# Tenant connections store the token encrypted in integration_credentials.
PF_META_TEST_ACCESS_TOKEN=replace-with-temporary-meta-test-token

# Generate with: openssl rand -base64 32
PF_CREDENTIAL_KEY_ID=pilot-key-v1
PF_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Generate with: openssl rand -base64 48
PF_WORKER_TRIGGER_SECRET=replace-with-a-long-random-secret

PF_LIVE_SENDS_ENABLED=false
PF_PILOT_MAX_TENANTS=2
PF_PILOT_MAX_CAMPAIGN_RECIPIENTS=100
PF_PILOT_PHONE_SENDS_PER_SECOND=1
PF_WORKER_BATCH_SIZE=10
PF_WORKER_TIME_BUDGET_SECONDS=20
