# Root reference for deployment configuration. For local Next.js development,
# copy apps/web/.env.example to apps/web/.env.local and fill it privately.
# Hostinger app: web/API runtime. Never commit filled values.
PF_ENV=development
PF_APP_URL=https://app.example.com
PF_SITE_URL=https://www.example.com
PF_DEPLOYMENT_PROFILE=hostinger-pilot
PF_LOG_LEVEL=info

# Only these public values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server only. Prefer JWT-scoped data access; privileged key for narrow admin tasks.
PF_SUPABASE_URL=https://PROJECT.supabase.co
PF_SUPABASE_SERVER_KEY=replace-with-server-secret-key
PF_DATABASE_URL=replace-with-server-only-pooled-postgres-url

# Meta webhook receiver secrets belong in Supabase Edge Function secret settings.
# OAuth/Graph adapter secrets also belong in the server runtime that calls Meta.
PF_META_APP_ID=replace-with-meta-app-id
PF_META_APP_SECRET=replace-with-meta-app-secret
PF_META_WEBHOOK_VERIFY_TOKEN=replace-with-random-verification-token
PF_META_GRAPH_VERSION=replace-with-current-supported-version
PF_META_SIGNUP_CONFIG_ID=replace-after-configuring-embedded-signup
# Optional local pilot references. Temporary access tokens expire and stay server-only.
PF_META_TEST_PHONE_NUMBER_ID=replace-with-meta-test-phone-number-id
PF_META_TEST_WABA_ID=replace-with-meta-test-waba-id
PF_META_TEST_ACCESS_TOKEN=replace-with-temporary-meta-test-token

# Worker runtime only; database stores encrypted per-tenant integration tokens.
PF_CREDENTIAL_KEY_ID=pilot-key-v1
PF_CREDENTIAL_ENCRYPTION_KEY=replace-with-secret-32-byte-key-in-selected-encoding
PF_WORKER_TRIGGER_SECRET=replace-with-random-internal-trigger-secret
PF_QUEUE_ADAPTER=pgmq
PF_OBJECT_STORAGE_ADAPTER=supabase
PF_AI_PROVIDER=disabled
PF_AI_API_KEY=replace-only-if-ai-enabled
PF_AI_MODEL=REQUIRED_SELECT_AND_EVALUATE_MODEL

# Pilot safety defaults: application settings, not claims about Meta limits.
PF_LIVE_SENDS_ENABLED=false
PF_PILOT_MAX_TENANTS=2
PF_PILOT_MAX_CAMPAIGN_RECIPIENTS=100
PF_PILOT_PHONE_SENDS_PER_SECOND=1
PF_WORKER_BATCH_SIZE=10
PF_WORKER_TIME_BUDGET_SECONDS=20

# Local provisioning tooling only; do not copy to frontend or client SDK.
# Supabase's reserved SUPABASE_* names are not used for custom Edge secrets.
PF_SMTP_PROVIDER=configure-through-supabase-auth
